    "admin": "node bin/admin.js",
    "rpa": "node bin/rpa.js",
    "verify": "node --import ./test/setup.js --test --test-concurrency=1 \"test/*.test.js\"",
    "bootstrap": "bash scripts/bootstrap-browser-env.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
