{
  "name": "browser-rpa-collector",
  "version": "1.0.0",
  "private": true,
  "description": "Resumable browser RPA collection pipeline with checkpointed state, download ledger and admin dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --import ./test/setup.js --test --test-concurrency=1 \"test/*.test.js\"",
